# Backend environment variables
# Copy this file to .env.local and fill in your values

# MongoDB connection string
# In development, the server auto-creates an in-memory MongoDB — no setup needed
MONGODB_URI=mongodb://localhost:27017/parivahan-rto

# OpenRouter API key for AI assistant
# Get yours at https://openrouter.ai/
# Without this, the AI assistant runs in offline/fallback FAQ mode
OPENROUTER_API_KEY=

# OpenRouter model to use (default: z-ai/glm-5.3-flash)
# Other options: anthropic/claude-haiku-4-5, google/gemini-flash-1.5, meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL=z-ai/glm-5.3-flash

# Server ports
PORT=4000                           # Express API port (standalone mode: api-server.ts)
FRONTEND_URL=http://localhost:3000   # CORS origin for the Next.js frontend

# Session secret (change in production)
SESSION_SECRET=parivahan-demo-key-2024
